PORT=3001

# Cadena de conexión PostgreSQL
# Local:   postgresql://USUARIO:CLAVE@localhost:5434/estudiantes?schema=public
# AWS RDS: postgresql://USUARIO:CLAVE@<instancia>.<region>.rds.amazonaws.com:5432/estudiantes?schema=public&sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5434/estudiantes?schema=public

# Solo para docker-compose local
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=estudiantes

# AWS S3 (fotografías de estudiantes). Obligatorias: el servicio no arranca sin ellas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# Solo con credenciales temporales (AWS Academy / STS); si no aplica, dejar vacío
AWS_SESSION_TOKEN=
