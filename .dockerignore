# Dependencias: se instalan dentro de la imagen
node_modules

# Variables de entorno y secretos (se inyectan al ejecutar el contenedor)
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*

# Compilación local: dist se genera en la etapa de build
dist

# Archivos que no necesita la imagen
.git
.gitignore
docs
scripts
*.md
Dockerfile
.dockerignore
